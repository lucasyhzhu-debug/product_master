{
  "permissions": {
    "allow": [
      "mcp__plugin_figma_figma__generate_diagram",
      "Skill(gsd:update)",
      "Skill(gsd:progress)",
      "Skill(gsd:progress:*)",
      "Skill(gsd:audit-milestone)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(del /f /s *)",
      "Bash(del /q /s *)",
      "Bash(rmdir /s *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git clean -d*)",
      "Bash(git branch -D*)",
      "Bash(git checkout --*)",
      "Bash(git restore .*)",
      "Bash(format *)",
      "Bash(mkfs *)",
      "Bash(dd if=*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File .claude/hooks/context-alert.ps1"
          }
        ]
      }
    ]
  }
}
