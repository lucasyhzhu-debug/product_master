  "statusLine": {
    "type": "command",
    "command": "input=$(cat); cwd=$(echo \"$input\" | jq -r '.workspace.current_dir // .cwd'); dir=$(basename \"$cwd\" 2>/dev/null || echo \"~\"); branch=$(cd \"$cwd\" 2>/dev/null && git branch --show-current 2>/dev/null || echo \"\"); modified=$(cd \"$cwd\" 2>/dev/null && git diff-index --quiet HEAD -- 2>/dev/null && echo \"\" || echo \"*\"); model=$(echo \"$input\" | jq -r '.model.display_name' | sed 's/Claude //' | sed 's/ Sonnet//'); remaining=$(echo \"$input\" | jq -r '.context_window.remaining_percentage // empty'); style=$(echo \"$input\" | jq -r '.output_style.name // \"default\"'); printf \"\\033[32m%s\\033[0m\" \"$dir\"; [ -n \"$branch\" ] && printf \" \\033[36m(%s%s)\\033[0m\" \"$branch\" \"$modified\"; printf \" \\033[35m%s\\033[0m\" \"$model\"; [ -n \"$remaining\" ] && printf \" \\033[33mctx:%.0f%%\\033[0m\" \"$remaining\"; [ \"$style\" != \"default\" ] && printf \" \\033[34m[%s]\\033[0m\" \"$style\"; echo"
  }
