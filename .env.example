# =============================================================================
# CONVEX ENVIRONMENT CONFIGURATION
# =============================================================================
# This is a TEMPLATE file. Do not edit .env.local directly.
# Use environment switching scripts instead:
#
#   npm run env:prod      - Switch to production
#   npm run env:testing   - Switch to testing
#
# See docs/TESTING_GUIDE.md for full documentation
# =============================================================================

# Convex Deployment URL (same for all environments)
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Convex Site URL
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# Deployment Identifier
# Production: CONVEX_DEPLOYMENT=dev:your-deployment-name
# Testing:    CONVEX_DEPLOYMENT=dev:your-deployment-name:testing
CONVEX_DEPLOYMENT=dev:your-deployment-name

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================
# 1. Run: npx convex dev
#    This will create your deployment and update .env.local
#
# 2. Copy .env.local to .env.local.production (your production config)
#
# 3. Create .env.local.testing with ":testing" suffix:
#    CONVEX_DEPLOYMENT=dev:your-deployment-name:testing
#
# 4. Switch environments with:
#    npm run env:prod      - Use production database
#    npm run env:testing   - Use testing database
#
# =============================================================================
