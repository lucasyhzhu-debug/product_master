# Local Development
DATABASE_URL=sqlite:///./data/malo_recipes.db
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000/api

# Admin Endpoints Secret (REQUIRED for production)
# Generate a strong random secret for production use
# Used for /api/admin/init-db, /api/admin/seed-only, /api/admin/db-check
ADMIN_SECRET=your-secure-random-secret-here

