{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "build": {
    "env": {
      "PYTHON_VERSION": "3.12",
      "PYO3_USE_ABI3_FORWARD_COMPATIBILITY": "1"
    }
  },
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
